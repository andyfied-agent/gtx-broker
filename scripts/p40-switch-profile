#!/bin/bash
# p40-switch-profile - Root-owned P40 profile switch wrapper
# Usage: sudo /usr/local/sbin/compute01-maint/p40-switch-profile <profile-name>
#
# Profiles: qwen35-coding, qwen35-vision, qwen36-vision
# This script:
#   1. Validates profile name against allowlist
#   2. Atomically updates llama.cpp config
#   3. Restarts llama-qwen35.service
#   4. Verifies service health
#   5. Verifies model loaded correctly
#   6. Runs smoke test (text for all, multimodal for vision profiles)

set -euo pipefail

PROFILE_NAME="$1"
CONFIG_DIR="/etc/llama-cpp/profiles"
SERVICE_NAME="llama-qwen35.service"
HOST="127.0.0.1"
PORT="11436"
SMOKE_TIMEOUT=30

# Allowlist of valid profiles
ALLOWED_PROFILES=("qwen35-coding" "qwen35-vision" "qwen36-vision")

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

log_info() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

log_warn() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

log_error() {
    echo -e "${RED}[ERROR]${NC} $1" >&2
}

# Validate profile name
validate_profile() {
    local profile="$1"
    
    if [[ -z "$profile" ]]; then
        log_error "Profile name required"
        exit 1
    fi
    
    # Check against allowlist
    local found=false
    for allowed in "${ALLOWED_PROFILES[@]}"; do
        if [[ "$profile" == "$allowed" ]]; then
            found=true
            break
        fi
    done
    
    if [[ "$found" == "false" ]]; then
        log_error "Invalid profile: $profile. Allowed: ${ALLOWED_PROFILES[*]}"
        exit 1
    fi
    
    log_info "Validated profile: $profile"
}

# Get profile config
get_profile_config() {
    local profile="$1"
    local config_file="$CONFIG_DIR/${profile}.conf"
    
    if [[ ! -f "$config_file" ]]; then
        log_error "Profile config not found: $config_file"
        exit 1
    fi
    
    echo "$config_file"
}

# Update llama.cpp config atomically
update_config() {
    local profile="$1"
    local config_file=$(get_profile_config "$profile")
    
    log_info "Updating llama.cpp config to: $config_file"
    
    # Use atomic rename: write to temp, then mv
    local temp_file="${config_file}.tmp.$$"
    cp "$config_file" "$temp_file"
    mv "$temp_file" "$config_file"
    
    log_info "Config updated successfully"
}

# Restart systemd service
restart_service() {
    local service="$1"
    
    log_info "Restarting $service"
    
    if ! systemctl restart "$service"; then
        log_error "Failed to restart $service"
        systemctl status "$service" --no-pager -l
        exit 1
    fi
    
    # Wait for service to be active
    log_info "Waiting for $service to become active..."
    local wait_count=0
    local max_wait=60
    
    while [[ $wait_count -lt $max_wait ]]; do
        if systemctl is-active --quiet "$service"; then
            log_info "Service $service is active"
            return 0
        fi
        sleep 1
        ((wait_count++))
    done
    
    log_error "Service $service did not become active within ${max_wait}s"
    systemctl status "$service" --no-pager -l
    exit 1
}

# Check service health endpoint
check_health() {
    local host="$1"
    local port="$2"
    local url="http://${host}:${port}/health"
    
    log_info "Checking health endpoint: $url"
    
    if ! curl -sf --max-time 10 "$url" > /dev/null 2>&1; then
        log_error "Health check failed: $url"
        return 1
    fi
    
    log_info "Health check passed"
    return 0
}

# Verify model loaded correctly
verify_model() {
    local host="$1"
    local port="$2"
    local expected_model_id="$3"
    local url="http://${host}:${port}/v1/models"
    
    log_info "Verifying model loaded: $expected_model_id"
    
    local response
    response=$(curl -sf --max-time 10 "$url" 2>/dev/null) || {
        log_error "Failed to query /v1/models"
        return 1
    }
    
    # Check if expected model ID is in response
    if ! echo "$response" | grep -q "\"id\": \"$expected_model_id\""; then
        log_error "Model mismatch. Expected: $expected_model_id"
        log_error "Actual models: $response"
        return 1
    fi
    
    log_info "Model verification passed: $expected_model_id"
    return 0
}

# Verify slots available
verify_slots() {
    local host="$1"
    local port="$2"
    local url="http://${host}:${port}/v1/slots"
    
    log_info "Checking slots availability: $url"
    
    local response
    response=$(curl -sf --max-time 10 "$url" 2>/dev/null) || {
        log_warn "Slots endpoint not available (this is OK for some llama.cpp versions)"
        return 0
    }
    
    # Check if any slots are available
    if echo "$response" | grep -q '"available": true' || echo "$response" | grep -q '"used": 0'; then
        log_info "Slots verification passed"
        return 0
    else
        log_warn "No slots available (service may be busy)"
        return 0
    fi
}

# Run smoke test
run_smoke_test() {
    local host="$1"
    local port="$2"
    local profile="$3"
    local url="http://${host}:${port}/v1/chat/completions"
    
    log_info "Running smoke test for profile: $profile"
    
    if [[ "$profile" == *"vision"* ]]; then
        log_info "Running multimodal smoke test..."
        run_multimodal_smoke_test "$url"
    else
        log_info "Running text-only smoke test..."
        run_text_smoke_test "$url"
    fi
    
    log_info "Smoke test passed"
}

# Text-only smoke test
run_text_smoke_test() {
    local url="$1"
    local prompt="Reply with exactly: OK"
    
    local response
    response=$(curl -sf --max-time 30 -X POST "$url" \
        -H "Content-Type: application/json" \
        -d "{
            \"model\": \"qwen3.5\",
            \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}],
            \"max_tokens\": 8,
            \"temperature\": 0
        }" 2>/dev/null) || {
        log_error "Smoke test request failed"
        return 1
    }
    
    # Check for expected response
    if echo "$response" | grep -q '"OK"'; then
        log_info "Text smoke test passed"
        return 0
    else
        log_error "Smoke test failed. Response: $response"
        return 1
    fi
}

# Multimodal smoke test (vision profiles)
run_multimodal_smoke_test() {
    local url="$1"
    local test_image="/usr/local/share/gtx-broker/test-images/receipt_small.jpg"
    
    if [[ ! -f "$test_image" ]]; then
        log_error "Test image not found: $test_image"
        log_warn "Skipping multimodal smoke test - install test image or disable vision profile"
        return 0
    fi
    
    # Encode image as base64
    local image_data
    image_data=$(base64 -w 0 "$test_image")
    
    local response
    response=$(curl -sf --max-time 60 -X POST "$url" \
        -H "Content-Type: application/json" \
        -d "{
            \"model\": \"qwen3.5-vision\",
            \"messages\": [{
                \"role\": \"user\",
                \"content\": [
                    {\"type\": \"image_url\", \"image_url\": {\"url\": \"data:image/jpeg;base64,$image_data\"}},
                    {\"type\": \"text\", \"text\": \"Extract the total amount from this receipt. Reply with exactly: OK\"}
                ]
            }],
            \"max_tokens\": 16,
            \"temperature\": 0
        }" 2>/dev/null) || {
        log_error "Multimodal smoke test request failed"
        return 1
    }
    
    # Check for expected response
    if echo "$response" | grep -q '"OK"'; then
        log_info "Multimodal smoke test passed"
        return 0
    else
        log_error "Multimodal smoke test failed. Response: $response"
        return 1
    fi
}

# Main execution
main() {
    log_info "P40 profile switch started"
    
    # Validate arguments
    validate_profile "$PROFILE_NAME"
    
    # Update config
    update_config "$PROFILE_NAME"
    
    # Restart service
    restart_service "$SERVICE_NAME"
    
    # Verify health
    check_health "$HOST" "$PORT"
    
    # Get expected model ID from config (simple extraction)
    local config_file=$(get_profile_config "$PROFILE_NAME")
    local expected_model_id
    expected_model_id=$(grep "expected_model_id" "$config_file" | sed 's/.*": "\([^"]*\)".*/\1/')
    
    if [[ -z "$expected_model_id" ]]; then
        log_error "Could not extract expected_model_id from config"
        exit 1
    fi
    
    # Verify model
    verify_model "$HOST" "$PORT" "$expected_model_id"
    
    # Verify slots
    verify_slots "$HOST" "$PORT"
    
    # Run smoke test
    run_smoke_test "$HOST" "$PORT" "$PROFILE_NAME"
    
    log_info "P40 profile switch completed successfully: $PROFILE_NAME"
}

# Run main
main "$@"
