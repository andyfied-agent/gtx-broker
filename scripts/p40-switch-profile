#!/bin/bash
# p40-switch-profile - Root-owned P40 profile switch wrapper

set -euo pipefail

PROFILE_NAME="$1"
PROFILES_DIR="/etc/llama-cpp/profiles"
ACTIVE_CONFIG="/etc/llama-cpp/p40-active.conf"
SERVICE_NAME="llama-qwen35.service"
HOST="127.0.0.1"
PORT="11436"
TEST_IMAGE="/usr/local/share/gtx-broker/test-images/receipt_small.jpg"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1" >&2; }

validate_profile() {
    local profile="$1"
    if [[ -z "$profile" ]]; then
        log_error "Profile name required"
        exit 1
    fi
    local found=false
    local allowed_profiles=("qwen35-coding" "qwen35-vision" "qwen36-vision")
    for allowed in "${allowed_profiles[@]}"; do
        [[ "$profile" == "$allowed" ]] && found=true && break
    done
    if [[ "$found" == "false" ]]; then
        log_error "Invalid profile: $profile. Allowed: qwen35-coding, qwen35-vision, qwen36-vision"
        exit 1
    fi
    if [[ ! -f "$PROFILES_DIR/${profile}.conf" ]]; then
        log_error "Profile config not found: $PROFILES_DIR/${profile}.conf"
        exit 1
    fi
    log_info "Validated profile: $profile"
}

update_active_config() {
    local profile="$1"
    local target_config="$PROFILES_DIR/${profile}.conf"
    log_info "Updating active config symlink to: ${profile}.conf"
    local temp_symlink="${ACTIVE_CONFIG}.tmp.$$"
    ln -sfn "$target_config" "$temp_symlink"
    mv -T "$temp_symlink" "$ACTIVE_CONFIG"
    if [[ "$(readlink -f "$ACTIVE_CONFIG")" != "$target_config" ]]; then
        log_error "Failed to update active config symlink"
        exit 1
    fi
    log_info "Active config updated successfully"
}

restart_service() {
    local service="$1"
    log_info "Restarting $service"
    if ! systemctl restart "$service"; then
        log_error "Failed to restart $service"
        systemctl status "$service" --no-pager -l
        exit 1
    fi
    log_info "Waiting for $service to become active..."
    local wait_count=0
    while [[ $wait_count -lt 60 ]]; do
        if systemctl is-active --quiet "$service"; then
            log_info "Service $service is active"
            return 0
        fi
        sleep 1
        ((wait_count++))
    done
    log_error "Service $service did not become active within 60s"
    exit 1
}

check_health() {
    log_info "Checking health endpoint: http://${HOST}:${PORT}/health"
    if ! curl -sf --max-time 10 "http://${HOST}:${PORT}/health" > /dev/null 2>&1; then
        log_error "Health check failed"
        return 1
    fi
    log_info "Health check passed"
    return 0
}

verify_model() {
    local host="$1"
    local port="$2"
    local expected_model_id="$3"
    log_info "Verifying model loaded: $expected_model_id"
    local response
    response=$(curl -sf --max-time 10 "http://${host}:${port}/v1/models" 2>/dev/null) || {
        log_error "Failed to query /v1/models"
        return 1
    }
    if ! echo "$response" | python3 -c "import sys, json; data=json.load(sys.stdin); 
    if 'data' in data and len(data['data'])>0: 
        sys.exit(0 if data['data'][0].get('id')=='$expected_model_id' else 1)
    else: sys.exit(1)" 2>/dev/null; then
        log_error "Model mismatch. Expected: $expected_model_id"
        return 1
    fi
    log_info "Model verification passed: $expected_model_id"
    return 0
}

verify_slots() {
    log_info "Checking slots availability"
    if ! curl -sf --max-time 5 "http://${HOST}:${PORT}/v1/slots" > /dev/null 2>&1; then
        log_warn "Slots endpoint not available (OK for some llama.cpp versions)"
    fi
    return 0
}

run_smoke_test() {
    local host="$1"
    local port="$2"
    local profile="$3"
    log_info "Running smoke test for profile: $profile"
    local model_id
    model_id=$(grep "^MODEL_ID=" "${ACTIVE_CONFIG}" 2>/dev/null | cut -d= -f2)
    if [[ "$profile" == *"vision"* ]]; then
        log_info "Running multimodal smoke test..."
        if [[ ! -f "$TEST_IMAGE" ]]; then
            log_error "Test image not found: $TEST_IMAGE"
            return 1
        fi
        local image_data
        image_data=$(base64 -w 0 "$TEST_IMAGE")
        local response
        response=$(curl -sf --max-time 60 -X POST "http://${host}:${port}/v1/chat/completions" \
            -H "Content-Type: application/json" \
            -d "{\"model\": \"$model_id\", \"messages\": [{\"role\": \"user\", \"content\": [{\"type\": \"image_url\", \"image_url\": {\"url\": \"data:image/jpeg;base64,$image_data\"}}, {\"type\": \"text\", \"text\": \"Extract the total amount from this receipt. Reply with exactly: 29.24\"}]}], \"max_tokens\": 16, \"temperature\": 0}" 2>/dev/null) || {
            log_error "Multimodal smoke test request failed"
            return 1
        }
        if echo "$response" | python3 -c "import sys, json; data=json.load(sys.stdin); 
        content=data.get('choices',[{}])[0].get('message',{}).get('content',''); 
        sys.exit(0 if '29.24' in content else 1)" 2>/dev/null; then
            log_info "Multimodal smoke test passed"
            return 0
        else
            log_error "Multimodal smoke test failed. Response: $response"
            return 1
        fi
    else
        log_info "Running text-only smoke test..."
        local prompt="Reply with exactly: OK"
        local response
        response=$(curl -sf --max-time 30 -X POST "http://${host}:${port}/v1/chat/completions" \
            -H "Content-Type: application/json" \
            -d "{\"model\": \"$model_id\", \"messages\": [{\"role\": \"user\", \"content\": \"$prompt\"}], \"max_tokens\": 8, \"temperature\": 0}" 2>/dev/null) || {
            log_error "Smoke test request failed"
            return 1
        }
        if echo "$response" | python3 -c "import sys, json; data=json.load(sys.stdin); 
        content=data.get('choices',[{}])[0].get('message',{}).get('content',''); 
        sys.exit(0 if 'OK' in content else 1)" 2>/dev/null; then
            log_info "Text smoke test passed"
            return 0
        else
            log_error "Smoke test failed. Response: $response"
            return 1
        fi
    fi
    log_info "Smoke test passed"
}

main() {
    log_info "P40 profile switch started"
    validate_profile "$PROFILE_NAME"
    update_active_config "$PROFILE_NAME"
    restart_service "$SERVICE_NAME"
    check_health "$HOST" "$PORT"
    local expected_model_id
    expected_model_id=$(grep "^MODEL_ID=" "$ACTIVE_CONFIG" 2>/dev/null | cut -d= -f2)
    if [[ -z "$expected_model_id" ]]; then
        log_error "Could not extract MODEL_ID from active config"
        exit 1
    fi
    verify_model "$HOST" "$PORT" "$expected_model_id"
    verify_slots "$HOST" "$PORT"
    run_smoke_test "$HOST" "$PORT" "$PROFILE_NAME"
    log_info "P40 profile switch completed successfully: $PROFILE_NAME"
}

main "$@"
